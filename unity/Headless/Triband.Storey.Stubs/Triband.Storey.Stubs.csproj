<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A compile check for the engine-facing assemblies of all three packages.

    Unity/*.cs, Editor/*.cs and the play kit reference UnityEngine and UnityEditor, which
    is the whole point of the assembly split, so the headless project cannot build them.
    They are built here instead, against hand-written declarations of exactly the engine
    members they use (Stubs/).

    This catches a typo, a renamed member, a wrong overload, a missing using and a
    reference to a package the manifest does not declare. It proves nothing about
    behaviour: every stub body is empty. It is cheaper than an editor round-trip for the
    class of mistake an editor round-trip would find in its first second, and it is the
    only check this half gets without a licence.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Triband.Storey.Stubs</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <!-- the packer's kernels work on pointers (Runtime/Generate/PackKernels.cs), as the Runtime assembly definition allows -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      No project-wide nullable setting. Every package source opens with `#nullable enable`
      (a layout rule enforces it), which leaves the stub files oblivious on purpose: they
      declare somebody else's API, and annotating them would invent a contract nobody
      verified.
    -->
    <!--
      No warning switched off here: the package code's are Unity's too, and are fixed. The stubs' own (unused events,
      never-assigned fields, == without Equals, which are the point of a declaration with an empty body) are switched
      off in the stub files themselves, and any other is an error.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- As Unity defines it when the project's active input handling includes the Input System (the play kit reads it). -->
    <DefineConstants>$(DefineConstants);ENABLE_INPUT_SYSTEM</DefineConstants>
  </PropertyGroup>

  <!--
    The editor's compile by default: UNITY_EDITOR, and the authoring package's editor code too. With -p:Player=true, a
    player's: no UNITY_EDITOR, no editor code and no UnityEditor stubs, so runtime code reaching an editor-only member
    fails here as it would in a build. With -p:Ios=true as well, iOS's: UNITY_IOS, so the native hooks' side compiles
    (the editor defines it too while iOS is the build target), and a field only the other side reads warns here.
  -->
  <PropertyGroup Condition="'$(Player)' != 'true'">
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <StubBuild>editor</StubBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Player)' == 'true'">
    <StubBuild>player</StubBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Ios)' == 'true'">
    <DefineConstants>$(DefineConstants);UNITY_IOS</DefineConstants>
    <StubBuild>$(StubBuild)-ios</StubBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StubBuild)' != 'editor'">
    <IntermediateOutputPath>obj/$(StubBuild)/$(Configuration)/</IntermediateOutputPath>
    <OutputPath>bin/$(StubBuild)/$(Configuration)/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Stubs/**/*.cs" />
    <Compile Include="../../Packages/com.triband.storey/Runtime/**/*.cs" />
    <Compile Include="../../Packages/com.triband.storey/Unity/**/*.cs" />
    <Compile Include="../../Packages/com.triband.storey/ColorPipeline/**/*.cs" />
    <Compile Include="../../Packages/com.triband.storey/Addressables/**/*.cs" />
    <Compile Include="../../Packages/com.triband.storey.authoring/Editor/**/*.cs" Condition="'$(Player)' != 'true'" />
    <Compile Remove="Stubs/UnityEditor.cs" Condition="'$(Player)' == 'true'" />
    <Compile Include="../../Packages/com.triband.storey.playkit/Runtime/**/*.cs" />
  </ItemGroup>

</Project>
